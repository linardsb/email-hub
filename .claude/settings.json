{
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(make:*)",
      "Bash(pnpm:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-dangerous.sh",
            "statusMessage": "Checking command safety..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-security.sh",
            "statusMessage": "Scanning for secrets..."
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Bash|Monitor|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_use.py\"; [ -f \"$f\" ] || f=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.claude/hooks/pre_tool_use.py\"; [ -f \"$f\" ] || { echo \"pre_tool_use.py not found; guardrails OFF for this call\" >&2; exit 1; }; exec python3 \"$f\"",
            "timeout": 30,
            "statusMessage": "Checking guardrails..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "git diff --name-only HEAD 2>/dev/null | head -10",
            "statusMessage": "Verifying edits persisted..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/restore-context.sh",
            "statusMessage": "Restoring agent context..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_check.py\"; [ -f \"$f\" ] || f=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.claude/hooks/stop_check.py\"; [ -f \"$f\" ] || { echo \"stop_check.py not found; stop check OFF\" >&2; exit 1; }; exec python3 \"$f\" --snapshot",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_check.py\"; [ -f \"$f\" ] || f=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.claude/hooks/stop_check.py\"; [ -f \"$f\" ] || { echo \"stop_check.py not found; stop check OFF\" >&2; exit 1; }; exec python3 \"$f\"",
            "timeout": 300,
            "statusMessage": "Fast check on changed files..."
          }
        ]
      }
    ]
  }
}
